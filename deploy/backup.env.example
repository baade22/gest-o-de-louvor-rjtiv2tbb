# Destino do backup (restic). Fica em /etc/louvorflow/backup.env, permissão 0600 root.
# Exemplo com Cloudflare R2 (S3): s3:https://<conta>.r2.cloudflarestorage.com/<bucket>
# Exemplo com Backblaze B2 (S3):  s3:https://s3.<regiao>.backblazeb2.com/<bucket>
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Senha que criptografa o backup. Guarde no gerenciador de senhas da igreja:
# sem ela, nenhum backup pode ser aberto. Gere com: openssl rand -base64 32
RESTIC_PASSWORD=
