# Segredos do LouvorFlow lidos pelo PocketBase. Fica em /etc/louvorflow/louvorflow.env
# (permissão 0600, root). Nunca commitar os valores. Depois de mudar: louvorflow-reiniciar
#
# Copie os valores da tela de segredos do Skip. No ENSAIO, deixe WHATSAPP_API_URL e
# WHATSAPP_API_KEY vazios: assim a cópia de teste não manda mensagem para ninguém.

# EXATAMENTE a mesma do Skip (32 caracteres). Sem ela as credenciais já criptografadas
# (bancos, YouTube, integrações) não abrem.
LOUVORFLOW_CREDENTIALS_KEY=

# WhatsApp (Evolution API, que já roda neste servidor). instalar.sh deixa preenchido com
# os valores do .env da pasta deploy/whatsapp, mas comentado até o dia da troca.
#WHATSAPP_API_URL=
#WHATSAPP_API_KEY=
# Endereço público deste servidor, usado nos links de mídia dos avisos e no webhook dos
# comprovantes. Depois da troca: https://gestao.ibmaldeia.com.br
WHATSAPP_MEDIA_BASE_URL=

# YouTube (busca de vídeos) e baixador (rota /youtube do servidor do WhatsApp).
YOUTUBE_API_KEY=
YOUTUBE_API_URL=

# Financeiro: mesmo valor do segredo BANK_SYNC_TOKEN do GitHub.
BANK_SYNC_TOKEN=
# Opcional: botão "Atualizar agora" dos saldos dispara o conector no GitHub.
BANK_SYNC_GITHUB_TOKEN=
BANK_SYNC_GITHUB_REPO=
BANK_SYNC_GITHUB_REF=

# Leitura de comprovantes por IA (se estiver cadastrada no Skip).
ANTHROPIC_API_KEY=
LOUVORFLOW_AI_MODEL=
LOUVORFLOW_AI_URL=

# Nunca ligar em produção: cria contas de demonstração com senha conhecida.
# LOUVORFLOW_ALLOW_DEMO_SEED=true
