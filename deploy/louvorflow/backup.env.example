# Cópia do backup FORA do servidor (restic, criptografado). Fica em
# /etc/louvorflow/backup.env, permissão 0600 root. Vazio = só a cópia local de 7 dias,
# que se perde junto se o servidor se perder.
#
# Cloudflare R2 (grátis até 10 GB): s3:https://<id-da-conta>.r2.cloudflarestorage.com/<bucket>
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Senha que criptografa o backup. Guarde no gerenciador de senhas da igreja: sem ela,
# nenhum backup abre. Gere com: openssl rand -base64 32
RESTIC_PASSWORD=
