# Segredos do LouvorFlow lidos pelo PocketBase. Fica em /etc/louvorflow/louvorflow.env
# (permissão 0640, grupo louvorflow). Nunca commitar os valores.

# Copiar EXATAMENTE a mesma do Skip (32 caracteres). Sem ela as credenciais já
# criptografadas (YouTube, integrações) não abrem.
LOUVORFLOW_CREDENTIALS_KEY=

# Chave da API do YouTube (busca de vídeos), a mesma do Skip.
YOUTUBE_API_KEY=

# Financeiro: o conector de bancos (GitHub Actions bank-sync.yml) chama o servidor com
# este token. Mesmo valor do segredo BANK_SYNC_TOKEN do GitHub, 32+ caracteres.
BANK_SYNC_TOKEN=

# Opcional, para o botão "Atualizar agora" dos saldos disparar o bank-sync no GitHub.
# BANK_SYNC_GITHUB_TOKEN=
# BANK_SYNC_GITHUB_REPO=baade22/gest-o-de-louvor-rjtiv2tbb
# BANK_SYNC_GITHUB_REF=main

# Nunca ligar em produção: cria contas de demonstração com senha conhecida.
# LOUVORFLOW_ALLOW_DEMO_SEED=true
