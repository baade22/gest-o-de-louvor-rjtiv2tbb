# Copie para .env (o setup.sh já cria sozinho) e preencha (o .env nunca vai para o GitHub).
# Endereço do servidor (um subdomínio apontando para o IP do servidor)
WHATSAPP_DOMAIN=zap.ibmaldeia.com.br
# Chave que o LouvorFlow usa para falar com o servidor. Gere com: openssl rand -hex 32
WHATSAPP_API_KEY=
# Senha do banco interno. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Proxy residencial (IP fixo do Brasil) para o WhatsApp não ver a conexão saindo de um
# datacenter. Opcional, mas recomendado. Deixe PROXY_HOST vazio para conectar sem proxy.
# Depois de mudar: docker compose up -d evolution (e leia o QR Code de novo, se pedir).
PROXY_HOST=
PROXY_PORT=
PROXY_PROTOCOL=http
PROXY_USERNAME=
PROXY_PASSWORD=
